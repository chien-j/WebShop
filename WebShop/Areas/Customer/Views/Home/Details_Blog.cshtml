@model Blog





<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm @Model.Title</title>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"> *@
</head>
<body>
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Home" asp-action="">@Model.Topic_tree.Name</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>


        <header class="text-white text-center py-3">
            <h1>@Model.Title</h1>
            <p class="lead"></p>
        </header>

        <section class="mb-4">
            <p> @Html.Raw(@Model.Introduction)</p>
        </section>

        <div class="mb-4">
            <div class="">
                <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.BlogImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.BlogImages[i].ImageUrl" class="d-block w-100 carousel-image" style="width: 500px; height: 500px; object-fit: cover;" alt="Product Image">
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>

        <!-- Introduction -->
        <section class="mb-4">
            <p> @Html.Raw(@Model.Body)</p>
        </section>
        <section class="mb-4">
            <p> @Html.Raw(@Model.Conclusion)</p>
        </section>
        <section class="mb-4">
            <div class=" top-0 end-0 p-3">
                <span class="d-block text-end fst-italic">Tác giả: @Model.TacGia</span>
                <span class="d-block text-end fst-italic">Thời gian: @Model.Byline</span>
            </div>
        </section>
        
    </div>
    <!-- Thời gian và tác giả ở góc phải -->
    
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script> *@
</body>
</html>
