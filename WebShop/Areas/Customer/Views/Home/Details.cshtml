@model Product





<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm @Model.TenCay</title>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"> *@
</head>
<body>
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-area="Customer" asp-controller="Home" asp-action="">@Model.Category.Name</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.TenCay</li>
            </ol>
        </nav>

        <div class="row">
            <div class="col-lg-5 col-md-6">
                <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.ProductImages.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.ProductImages[i].ImageUrl" class="d-block w-100 carousel-image" style="width: 500px; height: 500px; object-fit: cover;" alt="Product Image">
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <h1 class="h4">@Model.TenCay</h1>
               

                <div class="mb-3">
                    <label class="fw-bold">Tên Khoa Học:</label>
                    <div class="btn-group">
                        @Model.TenKhoaHoc
                    </div>
                </div>

                <div class="mb-3">
                    <label class="fw-bold">Tên gọi khác:</label>
                    <div class="btn-group">
                        @Model.TenGoiKhacCay
                    </div>
                </div>

               
                <div class="mb-3">
                    <label class="fw-bold">Chi Tiết: </label>
                    <div class="btn-group">
                       
                    </div>
                </div>
                <p class="text-muted">
                    @Html.Raw(@Model.MoTaCay)
                </p>

                <div class="mb-3">
                    <label class="fw-bold">Đặc điểm sinh học: </label>
                    <div class="btn-group">
                       
                    </div>
                </div>
                <p class="text-muted">
                    @Html.Raw(@Model.DacDiem)
                </p>
            </div>
        </div>

        <div class="mt-4">
            <h2 class="h5">Thông tin </h2>
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th scope="row">Phân bố và môi trường sống:</th>
                        <td>@Html.Raw(@Model.PhanBo_MoiTruong)</td>
                        <th scope="row">Thành phần các chất có trong cây:</th>
                        <td>@Html.Raw(@Model.ThanhPhan)</td>
                    </tr>
                    <tr>
                        <th scope="row">Công dụng:</th>
                        <td>@Html.Raw(@Model.CongDung)</td>
                        <th scope="row">Phần dùng làm thuốc:</th>
                        <td> @Html.Raw(@Model.PhanDungLamThuoc) </ td >
                    </tr>
                    <tr>
                        <th scope="row">Tính an toàn và tác dụng phụ:</th>
                        <td> @Html.Raw(@Model.AnToan_Tacdungphu) </ td >
                        
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script> *@
</body>
</html>
