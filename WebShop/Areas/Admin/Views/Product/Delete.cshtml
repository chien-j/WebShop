@model Product

<form method="post">
    @*<input asp-for="Id" />*@
    <div class="border p-3 mt-4">

        <div class="row pb-2">
            <h2 class="text-primary"> Xóa Sản Phẩm</h2>
            <hr />

        </div>
        <div asp-validation-summary="All"></div>
        <div class="mb-3 row p-1">
            <label asp-for="TenCay" class="p-2"></label>
            <input asp-for="TenCay" type="text" class="form-control" />
        </div>

        <div class="mb-3 row p-1">
            <label asp-for="TenGoiKhacCay" class="p-2"></label>
            <input asp-for="TenGoiKhacCay" type="text" class="form-control" />
        </div>


        <div class="mb-3 row p-1">
            <label asp-for="TenKhoaHoc" class="p-2"></label>
            <input asp-for="TenKhoaHoc" type="text" class="form-control" />
        </div>


        <div class="mb-3 row p-1">
            <label asp-for="MoTaCay" class="p-2"></label>
            <input asp-for="MoTaCay" type="text" class="form-control" />
        </div>
        
        <div class="mb-3 row p-1">
            <label asp-for="DacDiem" class="p-2"></label>
            <input asp-for="DacDiem" type="text" class="form-control" />
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="PhanBo_MoiTruong" class="p-2"></label>
            <input asp-for="PhanBo_MoiTruong" type="text" class="form-control" />
        </div>


        <div class="mb-3 row p-1">
            <label asp-for="ThanhPhan" class="p-2"></label>
            <input asp-for="ThanhPhan" type="text" class="form-control" />
        </div>


        <div class="mb-3 row p-1">
            <label asp-for="CongDung" class="p-2"></label>
            <input asp-for="CongDung" type="text" class="form-control" />
        </div>


        <div class="mb-3 row p-1">
            <label asp-for="PhanDungLamThuoc" class="p-2"></label>
            <input asp-for="PhanDungLamThuoc" type="text" class="form-control" />
        </div>


        <div class="mb-3 row p-1">
            <label asp-for="AnToan_Tacdungphu" class="p-2"></label>
            <input asp-for="AnToan_Tacdungphu" type="text" class="form-control" />
        </div>
       
       
        <div class="mb-3 row p-1">
            <div class="row p-4">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-danger form-control">Xóa</button>

                </div>
                <div class="col-6 col-md-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary  form-control">Quay trở về</a>
                </div>

            </div>
        </div>
    </div>
</form>
@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}